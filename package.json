{
  "name": "pi-subagents-extension",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.19.0" },
  "dependencies": {
    "typebox": "1.1.38"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "bun-types": "1.3.5",
    "typescript": "5.9.3"
  },
  "scripts": {
    "test": "bun scripts/run-tests.ts",
    "test:unit": "bun scripts/run-tests.ts --group unit",
    "test:transport": "bun scripts/run-tests.ts --group transport",
    "check:cgroup": "bun scripts/check-cgroup-v2.ts",
    "test:process": "bun scripts/run-tests.ts --group process",
    "test:controller": "bun scripts/run-tests.ts --group controller",
    "test:integration": "bun scripts/run-tests.ts --group integration",
    "test:live-model": "PI_SUBAGENTS_LIVE_SMOKE=1 bun test test/live-model-smoke.test.ts --timeout 120000",
    "typecheck": "tsc --noEmit"
  }
}
